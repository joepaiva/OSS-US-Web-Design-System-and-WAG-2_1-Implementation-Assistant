# Python/FastAPI Chassis Program packages — environment for the delivered artifact.
#
# Copy this file to `.env`, fill in the four values below, then run:
#   docker compose up --build
#
# THIS FILE CONTAINS NO SECRET VALUES, deliberately (AB-FR-612). It previously
# shipped a working JWT placeholder and a 64-zero encryption key as live
# assignments, in a file customers reasonably copy straight to .env. Every value
# here is one you generate; nothing is pre-filled for you to leave alone.
#
# docker compose will REFUSE to start and name any variable you miss.

# JWT signing secret. At least 32 characters.
#   openssl rand -hex 32
JWT_SECRET=

# MFA seed encryption. Exactly 64 hex characters (32 bytes).
#   openssl rand -hex 32
MFA_ENCRYPTION_KEY=

# LLM/MCP provider-credential encryption. Exactly 64 hex characters, and a
# DIFFERENT value from MFA_ENCRYPTION_KEY — they are separate keys so that
# compromising one does not expose the other.
# Required even if you are not using the LLM features: left unset, the chassis
# falls back to a published all-zero development key rather than failing.
#   openssl rand -hex 32
LLM_ENCRYPTION_KEY=

# Database password for the bundled postgres container.
#   openssl rand -hex 16
POSTGRES_PASSWORD=

# ── Optional ─────────────────────────────────────────────────────────────────
# Host port to publish the app on (default 8000).
# APP_HOST_PORT=8000
# DEBUG | INFO | WARNING | ERROR
# LOG_LEVEL=INFO
